<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cutie Fitness Tracker 🎀</title>
<style>
    :root {
        --bg1: #ffe6f0; --bg2: #fff0f5; --card: #fff; --border: #ffb6d9;
        --text: #5a3d5c; --pink: #ff69b4; --btn: #ffb6d9;
    }
  .dark {
        --bg1: #2a1a2e; --bg2: #1e1222; --card: #3a2a3f; --border: #ff69b4;
        --text: #ffe6f0; --pink: #ffb6d9; --btn: #ff69b4;
    }
    * { font-family: 'Comic Sans MS', cursive, sans-serif; transition: 0.3s; }
    body {
        background: linear-gradient(180deg, var(--bg1) 0%, var(--bg2) 100%);
        color: var(--text);
        padding: 15px;
        margin: 0;
    }
    h1 {
        color: var(--pink);
        text-align: center;
        text-shadow: 2px 2px 0 var(--card);
    }
  .topbar { display: flex; justify-content: space-between; align-items: center; }
  .toggle { font-size: 24px; background: none; border: none; box-shadow: none; cursor: pointer; }
 .btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
    button {
        background: var(--btn);
        color: var(--text);
        border: 2px solid var(--pink);
        padding: 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: bold;
        box-shadow: 0 4px 0 var(--pink);
        cursor: pointer;
    }
    button:active { transform: translateY(2px); box-shadow: 0 2px 0 var(--pink); }
 .del-btn { background: #ff9aa2; border-color: #ff6b81; }
 .edit-btn { background: #c7ceea; border-color: #a0a8d4; }
 .export-btn { background: #b5ead7; border-color: #7dd3c0; }
 .box {
        background: var(--card);
        padding: 15px;
        border-radius: 20px;
        margin-top: 15px;
        display: none;
        border: 2px dashed var(--border);
    }
    pre {
        background: var(--bg2);
        padding: 10px;
        overflow-x: auto;
        border-radius: 10px;
        font-size: 11px;
        border: 1px solid var(--border);
    }
    input, select {
        width: 95%;
        padding: 10px;
        margin: 6px 0;
        border-radius: 15px;
        border: 2px solid var(--border);
        background: var(--bg2);
        color: var(--text);
    }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { border: 1px solid var(--border); padding: 6px; text-align: center; font-size: 12px; }
    th { background: var(--btn); color: var(--text); }
 .cute { color: var(--pink); }
 .action-btn { padding: 4px 6px; font-size: 11px; border-radius: 10px; margin: 2px; }
  #chart { background: var(--bg2); border-radius: 15px; padding: 10px; margin-top: 10px; }
</style>
</head>
<body>

<div class="topbar">
    <h1>🎀 Cutie Fitness Tracker 🎀</h1>
    <button class="toggle" onclick="toggleTheme()">🌙</button>
</div>
<p style="text-align:center;">Track your workouts cutely!</p>

<div class="btn-group">
    <button onclick="showBox('er')">📊 ER Diagram</button>
    <button onclick="showBox('3nf')">💡 3NF Logic</button>
    <button onclick="showBox('sql')">📜 SQL Script</button>
    <button onclick="showBox('tracker')">✨ Add Workout</button>
    <button onclick="showBox('chart')">📈 Progress Chart</button>
    <button onclick="showBox('alarm')">⏰ Reminder</button>
    <button class="export-btn" onclick="exportSQL()">⬇️ Export SQL</button>
</div>

<!-- ER DIAGRAM -->
<div id="er" class="box">
<h3 class="cute">ER Diagram 🎀</h3>
<pre>
[USERS] 1───< [WORKOUTS] >───1 [EXERCISES]
                |
                <───
</pre>
</div>

<!-- 3NF -->
<div id="3nf" class="box">
<h3 class="cute">3NF Logic Thinking 💡</h3>
<p><b>1NF:</b> Walang repeating group. Hiwalay per SET.</p>
<p><b>2NF:</b> `reps` at `weight` nasa SETS kasi depende sa set_id.</p>
<p><b>3NF:</b> `muscle_group` nasa EXERCISES kasi depende sa exercise_id.</p>
</div>

<!-- SQL -->
<div id="sql" class="box">
<h3 class="cute">SQL Script 📜</h3>
<pre id="sqlCode">
CREATE TABLE USERS (user_id INTEGER PRIMARY KEY, name VARCHAR(50) NOT NULL);
CREATE TABLE EXERCISES (exercise_id INTEGER PRIMARY KEY, exercise_name VARCHAR(50));
CREATE TABLE WORKOUTS (workout_id INTEGER PRIMARY KEY, user_id INT, workout_date DATE);
CREATE TABLE SETS (set_id INTEGER PRIMARY KEY, workout_id INT, exercise_id INT, reps INT);
</pre>
<button onclick="copySQL()">📋 Copy SQL</button>
</div>

<!-- TRACKER -->
<div id="tracker" class="box">
<h3 class="cute">Add / Edit Workout ✨</h3>
<input type="hidden" id="editId">
<input type="text" id="name" placeholder="Your Name">
<input type="date" id="date">
<select id="exercise">
    <option>🏃 Running</option>
    <option>🏋️ Lifting</option>
    <option>🚴 Cycling</option>
    <option>🧘 Yoga</option>
    <option>🏊 Swimming</option>
</select>
<input type="number" id="reps" placeholder="Reps">
<input type="number" id="weight" placeholder="Weight kg">
<button id="saveBtn" onclick="saveData()">💾 Save Workout</button>

<h4 class="cute">Your Logs:</h4>
<table id="logTable"><tr><th>Date</th><th>Exercise</th><th>Reps</th><th>kg</th><th>Action</th></tr></table>
<button class="del-btn" onclick="clearAll()">🗑️ Clear All Data</button>
</div>

<!-- CHART -->
<div id="chart" class="box">
<h3 class="cute">📈 Your Progress</h3>
<canvas id="progressChart" width="300" height="200"></canvas>
<p style="font-size:12px;">Total Workouts: <span id="totalCount">0</span></p>
</div>

<!-- ALARM -->
<div id="alarm" class="box">
<h3 class="cute">⏰ Workout Reminder</h3>
<input type="time" id="alarmTime">
<button onclick="setAlarm()">🔔 Set Reminder</button>
<p id="alarmStatus">No alarm set</p>
<p style="font-size:11px;">Note: Gumagana lang pag naka-open yung app sa Acode</p>
</div>

<script>
let editing = false;

// DARK MODE
function toggleTheme() {
    document.body.classList.toggle('dark');
    localStorage.setItem('theme', document.body.classList.contains('dark')? 'dark' : 'light');
    document.querySelector('.toggle').innerText = document.body.classList.contains('dark')? '☀️' : '🌙';
}
if(localStorage.getItem('theme') === 'dark') {
    document.body.classList.add('dark');
    document.querySelector('.toggle').innerText = '☀️';
}

function showBox(id) {
    document.querySelectorAll('.box').forEach(b => b.style.display = 'none');
    document.getElementById(id).style.display = 'block';
    if(id === 'chart') drawChart();
}

function saveData() {
    let data = {
        id: editing? parseInt(document.getElementById('editId').value) : Date.now(),
        date: document.getElementById('date').value,
        exercise: document.getElementById('exercise').value,
        reps: document.getElementById('reps').value,
        weight: document.getElementById('weight').value
    };
    let logs = JSON.parse(localStorage.getItem('cutieLogs') || '[]');
    if(editing) {
        logs = logs.map(l => l.id === data.id? data : l);
        editing = false;
        document.getElementById('saveBtn').innerText = '💾 Save Workout';
    } else logs.push(data);
    localStorage.setItem('cutieLogs', JSON.stringify(logs));
    clearForm(); loadLogs(); alert('Saved! 🎀')
}

function clearForm() {
    document.getElementById('editId').value = '';
    document.getElementById('date').value = '';
    document.getElementById('reps').value = '';
    document.getElementById('weight').value = '';
}

function loadLogs() {
    let logs = JSON.parse(localStorage.getItem('cutieLogs') || '[]');
    let table = document.getElementById('logTable');
    table.innerHTML = '<tr><th>Date</th><th>Exercise</th><th>Reps</th><th>kg</th><th>Action</th></tr>';
    logs.forEach(l => {
        table.innerHTML += `<tr>
            <td>${l.date}</td><td>${l.exercise}</td><td>${l.reps}</td><td>${l.weight}</td>
            <td><button class="action-btn edit-btn" onclick="editLog(${l.id})">✏️</button>
                <button class="action-btn del-btn" onclick="deleteLog(${l.id})">X</button></td>
        </tr>`;
    });
    document.getElementById('totalCount').innerText = logs.length;
}

function editLog(id) {
    let logs = JSON.parse(localStorage.getItem('cutieLogs') || '[]');
    let log = logs.find(l => l.id === id);
    document.getElementById('editId').value = log.id;
    document.getElementById('date').value = log.date;
    document.getElementById('exercise').value = log.exercise;
    document.getElementById('reps').value = log.reps;
    document.getElementById('weight').value = log.weight;
    document.getElementById('saveBtn').innerText = '💾 Update Workout';
    editing = true; showBox('tracker');
}

function deleteLog(id) {
    let logs = JSON.parse(localStorage.getItem('cutieLogs') || '[]');
    logs = logs.filter(l => l.id!== id);
    localStorage.setItem('cutieLogs', JSON.stringify(logs));
    loadLogs();
}

function clearAll() {
    if(confirm('Delete all workouts? 🎀')) {
        localStorage.removeItem('cutieLogs');
        loadLogs();
    }
}

function exportSQL() {
    let sql = document.getElementById('sqlCode').innerText;
    let blob = new Blob([sql], {type: 'text/plain'});
    let a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'fitness_db.sql';
    a.click();
}

function copySQL() {
    navigator.clipboard.writeText(document.getElementById('sqlCode').innerText);
    alert('Copied! 📋');
}

function drawChart() {
    let logs = JSON.parse(localStorage.getItem('cutieLogs') || '[]');
    let ctx = document.getElementById('progressChart').getContext('2d');
    ctx.clearRect(0, 0, 300, 200);
    let counts = {}; logs.forEach(l => counts[l.date] = (counts[l.date] || 0) + 1);
    let dates = Object.keys(counts).slice(-7);
    ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--btn');
    dates.forEach((d, i) => {
        let h = counts[d] * 20;
        ctx.fillRect(i * 40 + 10, 200 - h, 30, h);
        ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--text');
        ctx.fillText(counts[d], i * 40 + 18, 200 - h - 5);
        ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--btn');
    });
}

// ALARM
function setAlarm() {
    let time = document.getElementById('alarmTime').value;
    if(!time) return alert('Pick a time muna 🎀');
    localStorage.setItem('alarmTime', time);
    document.getElementById('alarmStatus').innerText = 'Alarm set for: ' + time;
    checkAlarm();
}

function checkAlarm() {
    setInterval(() => {
        let alarmTime = localStorage.getItem('alarmTime');
        let now = new Date().toTimeString().slice(0,5);
        if(alarmTime === now) {
            alert('🎀 Time to workout cutie! 🎀');
            localStorage.removeItem('alarmTime');
            document.getElementById('alarmStatus').innerText = 'No alarm set';
        }
    }, 60000); // check every minute
}

loadLogs();
if(localStorage.getItem('alarmTime')) {
    document.getElementById('alarmStatus').innerText = 'Alarm set for: ' + localStorage.getItem('alarmTime');
}
</script>

</body>
</html>
