<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fitness Tracker - Acode</title>
<style>
    body { font-family: Arial; background: #111; color: #eee; padding: 15px; }
    h1 { color: #4CAF50; text-align: center; }
    button { background: #4CAF50; color: white; border: none; padding: 10px; margin: 5px; border-radius: 8px; width: 100%; font-size: 16px; }
    button:hover { background: #45a049; }
    .box { background: #1e1e1e; padding: 12px; border-radius: 10px; margin-top: 15px; display: none; }
    pre { background: #000; padding: 10px; overflow-x: auto; border-radius: 5px; font-size: 12px; }
    input, select { width: 95%; padding: 8px; margin: 5px 0; border-radius: 5px; border: 1px solid #444; background: #222; color: #eee; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { border: 1px solid #444; padding: 6px; text-align: left; font-size: 12px; }
    th { background: #333; }
</style>
</head>
<body>

<h1>💪 Fitness Tracker</h1>

<button onclick="toggle('er')">1. Show ER Diagram</button>
<button onclick="toggle('3nf')">2. 3NF Logic Thinking</button>
<button onclick="toggle('sql')">3. SQL Script / Properties</button>
<button onclick="toggle('tracker')">4. Add Workout</button>

<!-- ER DIAGRAM -->
<div id="er" class="box">
<h3>ER Diagram</h3>
<pre>
[USERS] 1---* [WORKOUTS] *---1 [EXERCISES]
   |                 |
   |                 *---* 
   |
   *---* [GOALS]

USERS(user_id PK, name, age, weight)
WORKOUTS(workout_id PK, user_id FK, date, duration)
EXERCISES(exercise_id PK, name, muscle_group)
SETS(set_id PK, workout_id FK, exercise_id FK, reps, weight)
GOALS(goal_id PK, user_id FK, target, deadline)
</pre>
<p>Relationships: 1 User has many Workouts. 1 Workout has many Sets. 1 Exercise can be in many Sets.</p>
</div>

<!-- 3NF EXPLANATION -->
<div id="3nf" class="box">
<h3>3NF - Logic Thinking</h3>
<p><b>Goal:</b> Remove redundancy and dependency issues</p>
<p><b>1NF:</b> All columns atomic. No repeating groups. <br>
   Ex: Instead of `exercises: "pushup, squat"` we split to separate SETS table</p>
<p><b>2NF:</b> No partial dependency. <br>
   Ex: `reps` and `weight` depend on `set_id`, not just `workout_id`. So we made SETS table.</p>
<p><b>3NF:</b> No transitive dependency. <br>
   Ex: `muscle_group` depends on `exercise_id`, not directly on `workout_id`. 
   So we separated EXERCISES table.</p>
<p><b>Result:</b> 5 tables with FKs. Less data duplication, easier to update.</p>
</div>

<!-- SQL SCRIPT -->
<div id="sql" class="box">
<h3>SQL Script - SQLite / MySQL</h3>
<pre>
-- PROPERTIES: PK=Primary Key, FK=Foreign Key, NOT NULL=Required

CREATE TABLE USERS (
    user_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name VARCHAR(50) NOT NULL,
    age INT,
    weight DECIMAL(5,2)
);

CREATE TABLE EXERCISES (
    exercise_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name VARCHAR(50) NOT NULL,
    muscle_group VARCHAR(50)
);

CREATE TABLE WORKOUTS (
    workout_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INT NOT NULL,
    date DATE NOT NULL,
    duration INT, -- minutes
    FOREIGN KEY (user_id) REFERENCES USERS(user_id)
);

CREATE TABLE SETS (
    set_id INTEGER PRIMARY KEY AUTOINCREMENT,
    workout_id INT NOT NULL,
    exercise_id INT NOT NULL,
    reps INT NOT NULL,
    weight DECIMAL(5,2),
    FOREIGN KEY (workout_id) REFERENCES WORKOUTS(workout_id),
    FOREIGN KEY (exercise_id) REFERENCES EXERCISES(exercise_id)
);

CREATE TABLE GOALS (
    goal_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INT NOT NULL,
    target VARCHAR(100),
    deadline DATE,
    FOREIGN KEY (user_id) REFERENCES USERS(user_id)
);
</pre>
</div>

<!-- TRACKER FORM -->
<div id="tracker" class="box">
<h3>Add Workout</h3>
<input type="text" id="name" placeholder="Your Name">
<input type="date" id="date">
<input type="text" id="exercise" placeholder="Exercise Name">
<input type="number" id="reps" placeholder="Reps">
<input type="number" id="weight" placeholder="Weight kg">
<button onclick="saveWorkout()">Save to Local</button>

<h4>Saved Workouts:</h4>
<table id="workoutTable">
<tr><th>Date</th><th>Exercise</th><th>Reps</th><th>Weight</th></tr>
</table>
</div>

<script>
function toggle(id) {
    document.querySelectorAll('.box').forEach(b => b.style.display = 'none');
    document.getElementById(id).style.display = 'block';
}

function saveWorkout() {
    let w = {
        date: document.getElementById('date').value,
        exercise: document.getElementById('exercise').value,
        reps: document.getElementById('reps').value,
        weight: document.getElementById('weight').value
    };
    let workouts = JSON.parse(localStorage.getItem('workouts') || '[]');
    workouts.push(w);
    localStorage.setItem('workouts', JSON.stringify(workouts));
    loadWorkouts();
}

function loadWorkouts() {
    let workouts = JSON.parse(localStorage.getItem('workouts') || '[]');
    let table = document.getElementById('workoutTable');
    table.innerHTML = '<tr><th>Date</th><th>Exercise</th><th>Reps</th><th>Weight</th></tr>';
    workouts.forEach(w => {
        table.innerHTML += `<tr><td>${w.date}</td><td>${w.exercise}</td><td>${w.reps}</td><td>${w.weight}</td></tr>`;
    });
}
loadWorkouts();
</script>

</body>
</html>
